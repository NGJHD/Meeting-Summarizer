{
  "llm": {
    "model": "auto",
    "ctx_size": 32768,
    "gpu_layers": "auto",
    "cpu_ffn_regex": "auto",
    "cache_type_k": "q8_0",
    "cache_type_v": "q8_0",
    "threads": "auto",
    "port": 8080,
    "startup_timeout_s": 180,
    "idle_timeout_s": 300
