# Meeting Summariser — what does NOT belong in the repository.
#
# The app ships as an unzipped folder containing ~30 GB of binaries and model
# weights. None of that is source, and none of it is versionable. The repo holds
# the orchestration code, the prompts and the frontend; DOWNLOAD_MODELS.bat
# fetches everything else.

# ---- shipped payload, fetched by DOWNLOAD_MODELS.bat --------------------
bin/
models/
runtime/

# ---- produced at runtime ------------------------------------------------
temp/
output/
*.partial

# Per-machine timings. Committing them would hand a new machine another
# machine's measurements, which is exactly what the estimator must not have.
calibration.json

# Written by run.bat, pointing at whichever port it settled on.
Open Meeting Summariser.url

# Written by the update script and the writable-folder probe.
update.log
.write-probe-*

# ---- development only, not shipped --------------------------------------
# `tools/` is a scratch area holding test audio and one-off comparison scripts.
# The exception is the release builder: it has to be in the repository for a
# release to be reproducible. It is still kept out of both zips -- see the
# EXCLUDE_PREFIXES filter in it.
tools/*
!tools/make_release.py
work/

# ---- editor / OS noise ---------------------------------------------------
__pycache__/
*.py[cod]
.vscode/
.idea/
Thumbs.db
desktop.ini
